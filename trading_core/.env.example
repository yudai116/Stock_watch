# Copy to .env and fill in. NEVER commit .env.

# Alpaca (data: bars + news)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Data feed: iex (free/paper accounts, default) or sip (paid data subscription)
ALPACA_FEED=iex

# Saxo Bank OpenAPI (execution, CFD)
SAXO_APP_KEY=
SAXO_APP_SECRET=
# sim or live
SAXO_ENV=sim
SAXO_REDIRECT_URI=http://localhost:8765/callback

# Optional: Polygon (PIT universe backfill for delisted tickers, D6)
POLYGON_API_KEY=

# SEC EDGAR requires a descriptive User-Agent with contact email
EDGAR_USER_AGENT=trading_core research contact@example.com

# Local data root (Parquet + SQLite). Defaults to ./datastore if unset.
TRADING_CORE_DATA_ROOT=
